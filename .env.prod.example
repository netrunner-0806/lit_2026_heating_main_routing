# Production .env for compose.prod.yaml (see docs/deployment.md, section 6).
# Create it manually on the server as DEPLOY_PATH/.env (mode 600); CI never creates, copies or changes it.
# Only the variables below are read by compose.prod.yaml; all values here are examples.

# PostgreSQL: applied only when the heatnet_heatnet-pg volume is initialized for the first time
POSTGRES_DB=heatnet
POSTGRES_USER=heatnet
# required: set a random value, e.g. the output of `openssl rand -hex 24`
POSTGRES_PASSWORD=

# number of parallel calculation workers (16 GB RAM target: one memory-heavy job at a time)
HEATNET_WORKERS=1
# max number of variants returned per job (1..3)
HEATNET_MAX_VARIANTS=3
# JVM options for the app container (16 GB RAM target); lower -Xmx on a server with less memory
JAVA_OPTS='-Xms1g -Xmx13g -XX:+UseG1GC -XX:+ExitOnOutOfMemoryError'

# required: public domain served by caddy, without scheme (automatic HTTPS via Let's Encrypt)
DOMAIN=heatnet.example.ru
# e-mail for the Let's Encrypt account
ACME_EMAIL=ops@example.ru

# Application image tag: absent or empty -> ghcr.io/netrunner-0806/heatnet:latest.
# Uncomment to pin production to a published 7-character commit tag (docs/deployment.md, section 7).
#HEATNET_IMAGE_TAG=a1b2c3d

# Normally not set: the Compose project name is "heatnet" (deploy passes it with -p; manual commands in
# /opt/heatnet get it from the directory name).
# Only to keep using an existing project of another name (docs/deployment.md, section 13).
#COMPOSE_PROJECT_NAME=
