# Copy to .env and adjust if needed (docker-compose.yml has development defaults for every value)
POSTGRES_DB=heatnet
POSTGRES_USER=heatnet
POSTGRES_PASSWORD=change_me
APP_PORT=8080
# host port of the PostgreSQL container (only for local tooling such as scripts/large-file-smoke.sh)
POSTGRES_PORT=5432
# number of parallel calculation workers (each job is CPU-heavy)
HEATNET_WORKERS=2
# max number of variants returned per job (1..3)
HEATNET_MAX_VARIANTS=3
# JVM options for the app container (16 GB RAM target: 6 GB heap is enough for the competition data)
JAVA_OPTS=-Xmx6g -XX:+UseG1GC

