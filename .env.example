# Copy to .env and adjust if needed (docker-compose.yml provides defaults for every value)
POSTGRES_DB=heatnet
POSTGRES_USER=heatnet
POSTGRES_PASSWORD=change_me
# number of parallel calculation workers (8 CPU / 16 GB RAM target: one memory-heavy job at a time)
HEATNET_WORKERS=1
# max number of variants returned per job (1..3)
HEATNET_MAX_VARIANTS=3
# JVM options for the app container (8 CPU / 16 GB RAM target: 1 GB initial heap, 13 GB maximum heap)
JAVA_OPTS=-Xms1g -Xmx13g -XX:+UseG1GC

# public domain served by caddy (automatic HTTPS via Let's Encrypt); "localhost" = self-signed local cert
DOMAIN=localhost
# e-mail for ACME / Let's Encrypt account
ACME_EMAIL=admin@example.com
